<Window x:Class="KatalogOkienkowy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Katalog Okienkowy"
        Height="600"
        Width="800">

    <StackPanel Margin="20" x:Name="GlownyStackPanel">
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">

            <TextBlock x:Name="EtykietaLiczby"
                   Text="Liczba produktów: 0"
                   FontSize="14"
                   Margin="0,10,0,0" />
            <TextBlock Text="0" FontSize="14"/>
        </StackPanel>
       
        
        <TextBlock Text="Katalog produktów"
                   FontSize="24"
                   FontWeight="Bold" />


        <TextBlock x:Name="EtykietaMagazynu"
                   Text="Wartość magazynu: 0 zł"
                   FontSize="14"
                   Margin="0,10,0,0" />

        <Button Content="Dodaj produkt"
                FontSize="16"
                FontWeight="Bold"
                <Image Source="pack://application:,,,/images/plus.png" Width="16" Height="16" Margin="0,0,5,0" />

            Width="16"
                       Height="16"
                       Margin="0,0,5,0" />
            Padding="5"
                Margin="0,15,0,15"
                HorizontalAlignment="Center" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0"
                    Grid.Column="0"
                    Content="Przycisk 1"
                    Margin="5" />

            <Button Grid.Row="0"
                    Grid.Column="1"
                    Content="Przycisk 2"
                    Margin="5" />

            <Button Grid.Row="1"
                    Grid.Column="0"
                    Content="Przycisk 3"
                    Margin="5" />

            <Button Grid.Row="1"
                    Grid.Column="1"
                    Content="Przycisk 4"
                    Margin="5" />
        </Grid>

    </StackPanel>
</Window>
